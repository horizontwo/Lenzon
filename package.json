{
  "name": "@lenzon/player",
  "version": "0.1.0",
  "type": "module",
  "description": "Lenzon player: a React runtime that plays a PresentationScript as an animated, narrated explainer.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./capture": {
      "types": "./dist/player/capture/captureMode.d.ts",
      "default": "./dist/player/capture/captureMode.js"
    },
    "./samples": {
      "types": "./dist/player/samples/index.d.ts",
      "default": "./dist/player/samples/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "default": "./dist/templates/index.js"
    },
    "./templates/registry": {
      "types": "./dist/templates/registry.d.ts",
      "default": "./dist/templates/registry.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:watch": "vite build -c vite.lib.config.ts --watch",
    "typecheck": "tsc -b --noEmit",
    "prepack": "npm run build"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horizontwo/lenzon.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@lenzon/explainer-format": "0.1.0",
    "@lottiefiles/dotlottie-web": "^0.44.0",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/animejs": "^3.1.12",
    "@types/three": "^0.183.1",
    "animejs": "^3.2.2",
    "prismjs": "^1.29.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
