{
  "name": "@lenzon/explainer-format",
  "version": "0.1.0",
  "description": "The PresentationScript format: what an explainer producer emits and a player plays.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
